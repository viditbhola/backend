SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key: backend ONLY. Never put it in the frontend or commit it.
SUPABASE_SERVICE_KEY=
# Optional. If set, JWTs are verified locally (HS256 projects). Leave empty to verify via Supabase Auth.
SUPABASE_JWT_SECRET=
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173
